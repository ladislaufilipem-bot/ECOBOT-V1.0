
#include <Servo.h>

// ============================================================
// ECOBOT - BLUE ROBOTICS LEAGUE (BRL)
// VERSAO 1.1
// APRESENTACAO INTERATIVA COM LOOP AUTOMATICO
// ============================================================


// ============================================================
// 1. PINAGEM - BASE DEFINIDA PELA EQUIPE
// ============================================================

// SENSOR ULTRASSONICO
const int PIN_TRIG = 7;
const int PIN_ECHO = 8;

// RODAS - MG996R 360
const int PIN_RODA_ESQ = 9;
const int PIN_RODA_DIR = 10;

// CABECA - MG995 180
const int PIN_CABECA = 11;

// BRACOS - MG995 180
const int PIN_BRACO_ESQ = 12;
const int PIN_BRACO_DIR = 13;

// LEDS
const int PIN_LED_VERMELHO = 2;
const int PIN_LED_AZUL = 3;
const int PIN_LED_VERDE = 4;


// ============================================================
// 2. OBJETOS DOS SERVOS
// ============================================================

Servo rodaEsq;
Servo rodaDir;

Servo cabeca;

Servo bracoEsq;
Servo bracoDir;


// ============================================================
// 3. CONFIGURACAO DO SENSOR
// AJUSTAR DURANTE OS TESTES
// ============================================================

// Distancia para detectar a aproximacao do visitante.

const float X1 = 20.0;

// Referencia da base original.
// Nao utilizada para parada durante o deslocamento,
// pois o sensor esta nas costas, apontado para tras.

const float X2 = 8.0;

// Numero de leituras consecutivas para ativar.

const int LEITURAS_PARA_ATIVAR = 3;

// Intervalo entre leituras do sensor.

const unsigned long INTERVALO_SENSOR_MS = 100;


// ============================================================
// 4. TEMPOS DA LOCOMOCAO
// AJUSTAR DURANTE OS TESTES
// ============================================================

// Tempo que o robo anda para frente.

const unsigned long TEMPO_AVANCO_MS = 2500;

// Tempo que o robo anda de re.

const unsigned long TEMPO_RETORNO_MS = 2500;

// Distancia minima de seguranca durante o retorno.

const float DISTANCIA_SEGURANCA_RETORNO_CM = 35.0;

// Tempo que o caminho deve permanecer livre.

const unsigned long TEMPO_CAMINHO_LIVRE_MS = 1000;

// Tempo que o visitante precisa permanecer fora da
// area de deteccao para o robo aceitar novo ciclo.

const unsigned long TEMPO_REARME_MS = 1500;

// Distancia adicional para confirmar que o visitante saiu.

const float MARGEM_REARME_CM = 5.0;


// ============================================================
// 5. VELOCIDADE DAS RODAS
// MG996R 360 - CALIBRAR FISICAMENTE
// ============================================================

// Parada individual das rodas.

const int RODA_PARADA_ESQ = 90;
const int RODA_PARADA_DIR = 90;

// AVANCO
// Valores herdados da base enviada.

const int RODA_FRENTE_ESQ = 180;
const int RODA_FRENTE_DIR = 0;

// RETORNO
// Sentidos opostos ao avanco.

const int RODA_RE_ESQ = 0;
const int RODA_RE_DIR = 180;


// ============================================================
// 6. CONFIGURACAO DA CABECA
// MG995 180
// ============================================================

// Posicao central.

const int ANG_CABECA_CENTRO = 90;

// Inspecao.

const int ANG_CABECA_ESQUERDA = 45;
const int ANG_CABECA_DIREITA = 135;

// Surpresa.

const int ANG_CABECA_SURPRESA_ESQ = 65;
const int ANG_CABECA_SURPRESA_DIR = 115;

// Indignacao / raiva.

const int ANG_CABECA_RAIVA_ESQ = 55;
const int ANG_CABECA_RAIVA_DIR = 125;

// Felicidade.

const int ANG_CABECA_FELIZ_ESQ = 70;
const int ANG_CABECA_FELIZ_DIR = 110;


// TEMPOS DA CABECA

const unsigned long TEMPO_CABECA_SURPRESA_MS = 450;

const unsigned long TEMPO_CABECA_RAIVA_MS = 400;

const unsigned long TEMPO_CABECA_INSPECAO_MS = 650;

const unsigned long TEMPO_CABECA_FELIZ_MS = 400;

const unsigned long TEMPO_CABECA_CENTRO_MS = 400;


// ============================================================
// 7. CONFIGURACAO DOS BRACOS
// MG995 180
// ============================================================

// IMPORTANTE:
// Os dois bracos estao conectados por uma estrutura de MDF.
//
// Os movimentos serao enviados juntos e gradualmente.
//
// O espelhamento deve ser confirmado na montagem real.

const bool ESPELHAR_BRACO_DIR = true;

// Ajuste fino do lado direito.

const int AJUSTE_BRACO_DIR = 0;


// POSICOES LOGICAS DOS BRACOS
// Valores iniciais da base enviada.
// Calibrar antes de colocar a lata.

const int ANG_BRACO_NEUTRO = 0;

const int ANG_BRACO_APROXIMA = 45;

const int ANG_BRACO_ENCAIXE = 70;

const int ANG_BRACO_LEVANTA = 120;

const int ANG_BRACO_COLOCA = 60;


// VELOCIDADE DOS BRACOS

const int PASSO_BRACO_GRAUS = 1;

const unsigned long INTERVALO_PASSO_BRACO_MS = 20;


// ============================================================
// 8. CONFIGURACAO DO LOOP
// ============================================================

// TRUE = retorna fisicamente ao ponto inicial.
// FALSE = nao realiza o retorno.

const bool FAZER_RETORNO_AO_INICIO = true;

// Pausas das etapas.

const unsigned long PAUSA_ANTES_COLETA_MS = 500;

const unsigned long PAUSA_APOS_ENCAIXE_MS = 500;

const unsigned long PAUSA_APOS_COLETA_MS = 700;

const unsigned long TEMPO_POSE_FINAL_MS = 1000;


// ============================================================
// 9. DEBUG
// ============================================================

const bool DEBUG = true;


// ============================================================
// 10. MAQUINA DE ESTADOS
// TODOS OS ESTADOS POSSUEM O PREFIXO EST_
// ============================================================

enum EstadoECOBOT {

  EST_AGUARDANDO,

  EST_DETECCAO,

  EST_EMOCAO_RAIVA,

  EST_INSPECAO,

  EST_LOCOMOCAO,

  EST_PARADA,

  EST_BRACO_APROXIMACAO,

  EST_BRACO_ENCAIXE,

  EST_PAUSA_ENCAIXE,

  EST_BRACO_LEVANTAMENTO,

  EST_EMOCAO_FELIZ,

  EST_BRACO_COLOCA,

  EST_PAUSA_COLOCA,

  EST_BRACO_NEUTRO,

  EST_FINALIZACAO,

  EST_AGUARDAR_CAMINHO_LIVRE,

  EST_RETORNO,

  EST_REARME

};


// Estado inicial.

EstadoECOBOT estadoAtual = EST_AGUARDANDO;


// ============================================================
// 11. VARIAVEIS DE CONTROLE
// ============================================================

unsigned long tempoEstado = 0;

unsigned long ultimaLeituraSensor = 0;

unsigned long tempoInicioMovimento = 0;

unsigned long tempoInicioRetorno = 0;

unsigned long tempoRetornoRestante = 0;

unsigned long tempoAreaLivre = 0;

int etapa = 0;

int leiturasAtivacao = 0;

bool areaLivreCronometrando = false;


// ============================================================
// 12. CONTROLE SINCRONIZADO DOS BRACOS
// ============================================================

int bracoAtual = ANG_BRACO_NEUTRO;

int bracoAlvo = ANG_BRACO_NEUTRO;

unsigned long ultimoPassoBracos = 0;


// Calcula a posicao espelhada do servo direito.

int calcularAnguloDireito(int anguloEsquerdo) {

  int anguloDireito;

  if (ESPELHAR_BRACO_DIR) {

    anguloDireito = 180 - anguloEsquerdo;

  } else {

    anguloDireito = anguloEsquerdo;

  }

  anguloDireito += AJUSTE_BRACO_DIR;

  return constrain(anguloDireito, 0, 180);

}


// Define a posicao desejada para os dois bracos.

void moverBracosPara(int angulo) {

  bracoAlvo = constrain(angulo, 0, 180);

}


// Atualiza os dois servos simultaneamente,
// avancando um grau por intervalo.

void atualizarBracos() {

  if (bracoAtual == bracoAlvo) {
    return;
  }

  if (millis() - ultimoPassoBracos < INTERVALO_PASSO_BRACO_MS) {
    return;
  }

  ultimoPassoBracos = millis();

  if (bracoAtual < bracoAlvo) {

    bracoAtual += PASSO_BRACO_GRAUS;

    if (bracoAtual > bracoAlvo) {
      bracoAtual = bracoAlvo;
    }

  } else {

    bracoAtual -= PASSO_BRACO_GRAUS;

    if (bracoAtual < bracoAlvo) {
      bracoAtual = bracoAlvo;
    }

  }

  // COMANDO DOS DOIS BRACOS NO MESMO CICLO.

  bracoEsq.write(bracoAtual);

  bracoDir.write(calcularAnguloDireito(bracoAtual));

}


// Verifica se os dois ja receberam a posicao final.

bool bracosConcluidos() {

  return bracoAtual == bracoAlvo;

}


// ============================================================
// 13. LEITURA DO HC-SR04
// ============================================================

float lerUltrassom() {

  digitalWrite(PIN_TRIG, LOW);

  delayMicroseconds(2);

  digitalWrite(PIN_TRIG, HIGH);

  delayMicroseconds(10);

  digitalWrite(PIN_TRIG, LOW);

  long duracao = pulseIn(PIN_ECHO, HIGH, 30000);

  if (duracao == 0) {
    return 999.0;
  }

  float distancia = (duracao * 0.0343) / 2.0;

  return distancia;

}


// ============================================================
// 14. CONTROLE DOS LEDS
// ============================================================

void setLED(bool azul, bool vermelho, bool verde) {

  digitalWrite(PIN_LED_AZUL, azul ? HIGH : LOW);

  digitalWrite(PIN_LED_VERMELHO, vermelho ? HIGH : LOW);

  digitalWrite(PIN_LED_VERDE, verde ? HIGH : LOW);

}


void olhosAzuis() {

  setLED(true, false, false);

}


void olhosVermelhos() {

  setLED(false, true, false);

}


void olhosVerdes() {

  setLED(false, false, true);

}


void olhosApagados() {

  setLED(false, false, false);

}


// ============================================================
// 15. CONTROLE DAS RODAS
// ============================================================

void pararRodas() {

  rodaEsq.write(RODA_PARADA_ESQ);

  rodaDir.write(RODA_PARADA_DIR);

}


void avancarRodas() {

  rodaEsq.write(RODA_FRENTE_ESQ);

  rodaDir.write(RODA_FRENTE_DIR);

}


void retornarRodas() {

  rodaEsq.write(RODA_RE_ESQ);

  rodaDir.write(RODA_RE_DIR);

}


// ============================================================
// 16. TRANSICAO DE ESTADOS
// ============================================================

void mudarEstado(EstadoECOBOT novoEstado) {

  estadoAtual = novoEstado;

  etapa = 0;

  tempoEstado = millis();

  if (DEBUG) {

    Serial.print("NOVO ESTADO: ");

    Serial.println((int)estadoAtual);

  }

}


// ============================================================
// 17. POSICAO INICIAL
// ============================================================

void posicaoInicial() {

  pararRodas();

  cabeca.write(ANG_CABECA_CENTRO);

  bracoAtual = ANG_BRACO_NEUTRO;

  bracoAlvo = ANG_BRACO_NEUTRO;

  bracoEsq.write(ANG_BRACO_NEUTRO);

  bracoDir.write(calcularAnguloDireito(ANG_BRACO_NEUTRO));

  olhosAzuis();

}


// ============================================================
// 18. SETUP
// ============================================================

void setup() {

  Serial.begin(9600);

  // SENSOR

  pinMode(PIN_TRIG, OUTPUT);

  pinMode(PIN_ECHO, INPUT);

  // LEDS

  pinMode(PIN_LED_VERMELHO, OUTPUT);

  pinMode(PIN_LED_AZUL, OUTPUT);

  pinMode(PIN_LED_VERDE, OUTPUT);

  // SERVOS

  rodaEsq.attach(PIN_RODA_ESQ);

  rodaDir.attach(PIN_RODA_DIR);

  cabeca.attach(PIN_CABECA);

  bracoEsq.attach(PIN_BRACO_ESQ);

  bracoDir.attach(PIN_BRACO_DIR);

  // POSICAO INICIAL

  posicaoInicial();

  ultimaLeituraSensor = millis();

  Serial.println("==============================");

  Serial.println("       ECOBOT - BRL");

  Serial.println("   SISTEMA INICIADO");

  Serial.println("   MODO APRESENTACAO LOOP");

  Serial.println("==============================");

}


// ============================================================
// 19. LOOP PRINCIPAL
// ============================================================

void loop() {

  unsigned long agora = millis();

  // Atualiza continuamente os bracos.

  atualizarBracos();


  switch (estadoAtual) {


    // ========================================================
    // ESTADO 1 - AGUARDANDO VISITANTE
    // ========================================================

    case EST_AGUARDANDO: {

      pararRodas();

      olhosAzuis();

      if (agora - ultimaLeituraSensor >= INTERVALO_SENSOR_MS) {

        ultimaLeituraSensor = agora;

        float distancia = lerUltrassom();

        if (DEBUG) {

          Serial.print("AGUARDANDO - Distancia: ");

          Serial.println(distancia);

        }

        if (distancia > 0 && distancia <= X1) {

          leiturasAtivacao++;

        } else {

          leiturasAtivacao = 0;

        }

        if (leiturasAtivacao >= LEITURAS_PARA_ATIVAR) {

          leiturasAtivacao = 0;

          Serial.println("VISITANTE DETECTADO!");

          mudarEstado(EST_DETECCAO);

        }

      }

      break;

    }


    // ========================================================
    // ESTADO 2 - DETECCAO / SURPRESA
    // ========================================================

    case EST_DETECCAO: {

      if (etapa == 0) {

        olhosVermelhos();

        cabeca.write(ANG_CABECA_SURPRESA_ESQ);

        etapa = 1;

        tempoEstado = agora;

      }

      else if (etapa == 1 &&
               agora - tempoEstado >= TEMPO_CABECA_SURPRESA_MS) {

        cabeca.write(ANG_CABECA_SURPRESA_DIR);

        etapa = 2;

        tempoEstado = agora;

      }

      else if (etapa == 2 &&
               agora - tempoEstado >= TEMPO_CABECA_SURPRESA_MS) {

        cabeca.write(ANG_CABECA_CENTRO);

        mudarEstado(EST_EMOCAO_RAIVA);

      }

      break;

    }


    // ========================================================
    // ESTADO 3 - EMOCAO: INDIGNACAO / RAIVA
    // ========================================================

    case EST_EMOCAO_RAIVA: {

      if (etapa == 0) {

        olhosVermelhos();

        cabeca.write(ANG_CABECA_RAIVA_ESQ);

        etapa = 1;

        tempoEstado = agora;

      }

      else if (etapa == 1 &&
               agora - tempoEstado >= TEMPO_CABECA_RAIVA_MS) {

        cabeca.write(ANG_CABECA_RAIVA_DIR);

        etapa = 2;

        tempoEstado = agora;

      }

      else if (etapa == 2 &&
               agora - tempoEstado >= TEMPO_CABECA_RAIVA_MS) {

        cabeca.write(ANG_CABECA_CENTRO);

        mudarEstado(EST_INSPECAO);

      }

      break;

    }


    // ========================================================
    // ESTADO 4 - INSPECAO DO AMBIENTE
    // ========================================================

    case EST_INSPECAO: {

      if (etapa == 0) {

        olhosVermelhos();

        cabeca.write(ANG_CABECA_ESQUERDA);

        etapa = 1;

        tempoEstado = agora;

      }

      else if (etapa == 1 &&
               agora - tempoEstado >= TEMPO_CABECA_INSPECAO_MS) {

        cabeca.write(ANG_CABECA_DIREITA);

        etapa = 2;

        tempoEstado = agora;

      }

      else if (etapa == 2 &&
               agora - tempoEstado >= TEMPO_CABECA_INSPECAO_MS) {

        cabeca.write(ANG_CABECA_CENTRO);

        etapa = 3;

        tempoEstado = agora;

      }

      else if (etapa == 3 &&
               agora - tempoEstado >= TEMPO_CABECA_CENTRO_MS) {

        mudarEstado(EST_LOCOMOCAO);

      }

      break;

    }


    // ========================================================
    // ESTADO 5 - LOCOMOCAO PARA FRENTE
    // ========================================================

    case EST_LOCOMOCAO: {

      if (etapa == 0) {

        olhosVermelhos();

        avancarRodas();

        tempoInicioMovimento = agora;

        etapa = 1;

        Serial.println("ECOBOT AVANCANDO!");

      }

      else if (agora - tempoInicioMovimento >= TEMPO_AVANCO_MS) {

        pararRodas();

        Serial.println("AVANCO CONCLUIDO!");

        mudarEstado(EST_PARADA);

      }

      break;

    }


    // ========================================================
    // ESTADO 6 - PARADA ANTES DA COLETA
    // ========================================================

    case EST_PARADA: {

      if (etapa == 0) {

        pararRodas();

        olhosAzuis();

        cabeca.write(ANG_CABECA_CENTRO);

        tempoEstado = agora;

        etapa = 1;

      }

      else if (agora - tempoEstado >= PAUSA_ANTES_COLETA_MS) {

        mudarEstado(EST_BRACO_APROXIMACAO);

      }

      break;

    }


    // ========================================================
    // ESTADO 7 - APROXIMACAO DOS BRACOS
    // ========================================================

    case EST_BRACO_APROXIMACAO: {

      if (etapa == 0) {

        moverBracosPara(ANG_BRACO_APROXIMA);

        etapa = 1;

      }

      else if (bracosConcluidos()) {

        mudarEstado(EST_BRACO_ENCAIXE);

      }

      break;

    }


    // ========================================================
    // ESTADO 8 - ENCAIXE NAS ALCAS
    // ========================================================

    case EST_BRACO_ENCAIXE: {

      if (etapa == 0) {

        moverBracosPara(ANG_BRACO_ENCAIXE);

        etapa = 1;

      }

      else if (bracosConcluidos()) {

        mudarEstado(EST_PAUSA_ENCAIXE);

      }

      break;

    }


    // ========================================================
    // ESTADO 9 - PAUSA DO ENCAIXE
    // ========================================================

    case EST_PAUSA_ENCAIXE: {

      if (agora - tempoEstado >= PAUSA_APOS_ENCAIXE_MS) {

        mudarEstado(EST_BRACO_LEVANTAMENTO);

      }

      break;

    }


    // ========================================================
    // ESTADO 10 - LEVANTAMENTO DA LATA
    // ========================================================

    case EST_BRACO_LEVANTAMENTO: {

      if (etapa == 0) {

        moverBracosPara(ANG_BRACO_LEVANTA);

        etapa = 1;

      }

      else if (bracosConcluidos()) {

        olhosVerdes();

        mudarEstado(EST_EMOCAO_FELIZ);

      }

      break;

    }


    // ========================================================
    // ESTADO 11 - EMOCAO: FELICIDADE
    // ========================================================

    case EST_EMOCAO_FELIZ: {

      if (etapa == 0) {

        olhosVerdes();

        cabeca.write(ANG_CABECA_FELIZ_ESQ);

        etapa = 1;

        tempoEstado = agora;

      }

      else if (etapa == 1 &&
               agora - tempoEstado >= TEMPO_CABECA_FELIZ_MS) {

        cabeca.write(ANG_CABECA_FELIZ_DIR);

        etapa = 2;

        tempoEstado = agora;

      }

      else if (etapa == 2 &&
               agora - tempoEstado >= TEMPO_CABECA_FELIZ_MS) {

        cabeca.write(ANG_CABECA_CENTRO);

        etapa = 3;

        tempoEstado = agora;

      }

      else if (etapa == 3 &&
               agora - tempoEstado >= TEMPO_CABECA_CENTRO_MS) {

        mudarEstado(EST_BRACO_COLOCA);

      }

      break;

    }


    // ========================================================
    // ESTADO 12 - COLOCAR A LATA
    // ========================================================

    case EST_BRACO_COLOCA: {

      if (etapa == 0) {

        moverBracosPara(ANG_BRACO_COLOCA);

        etapa = 1;

      }

      else if (bracosConcluidos()) {

        mudarEstado(EST_PAUSA_COLOCA);

      }

      break;

    }


    // ========================================================
    // ESTADO 13 - PAUSA APOS COLOCAR
    // ========================================================

    case EST_PAUSA_COLOCA: {

      if (agora - tempoEstado >= PAUSA_APOS_COLETA_MS) {

        mudarEstado(EST_BRACO_NEUTRO);

      }

      break;

    }


    // ========================================================
    // ESTADO 14 - BRACOS VOLTAM AO NEUTRO
    // ========================================================

    case EST_BRACO_NEUTRO: {

      if (etapa == 0) {

        moverBracosPara(ANG_BRACO_NEUTRO);

        etapa = 1;

      }

      else if (bracosConcluidos()) {

        cabeca.write(ANG_CABECA_CENTRO);

        mudarEstado(EST_FINALIZACAO);

      }

      break;

    }


    // ========================================================
    // ESTADO 15 - FINALIZACAO
    // ========================================================

    case EST_FINALIZACAO: {

      if (etapa == 0) {

        pararRodas();

        olhosVerdes();

        cabeca.write(ANG_CABECA_CENTRO);

        tempoRetornoRestante = TEMPO_RETORNO_MS;

        areaLivreCronometrando = false;

        tempoEstado = agora;

        etapa = 1;

        Serial.println("COLETA CONCLUIDA!");

      }

      else if (agora - tempoEstado >= TEMPO_POSE_FINAL_MS) {

        if (FAZER_RETORNO_AO_INICIO) {

          mudarEstado(EST_AGUARDAR_CAMINHO_LIVRE);

        } else {

          mudarEstado(EST_REARME);

        }

      }

      break;

    }


    // ========================================================
    // ESTADO 16 - AGUARDAR CAMINHO LIVRE
    // ========================================================

    case EST_AGUARDAR_CAMINHO_LIVRE: {

      pararRodas();

      if (agora - ultimaLeituraSensor >= INTERVALO_SENSOR_MS) {

        ultimaLeituraSensor = agora;

        float distancia = lerUltrassom();

        if (distancia >= DISTANCIA_SEGURANCA_RETORNO_CM) {

          if (!areaLivreCronometrando) {

            tempoAreaLivre = agora;

            areaLivreCronometrando = true;

          }

          else if (agora - tempoAreaLivre >= TEMPO_CAMINHO_LIVRE_MS) {

            if (tempoRetornoRestante > 0) {

              tempoInicioRetorno = agora;

              retornarRodas();

              mudarEstado(EST_RETORNO);

              Serial.println("RETORNO INICIADO!");

            } else {

              mudarEstado(EST_REARME);

            }

          }

        } else {

          areaLivreCronometrando = false;

          Serial.println("CAMINHO OCUPADO - AGUARDANDO");

        }

      }

      break;

    }


    // ========================================================
    // ESTADO 17 - RETORNO AO PONTO INICIAL
    // ========================================================

    case EST_RETORNO: {

      // Verifica se terminou o tempo de retorno.

      if (agora - tempoInicioRetorno >= tempoRetornoRestante) {

        pararRodas();

        tempoRetornoRestante = 0;

        Serial.println("RETORNO CONCLUIDO!");

        mudarEstado(EST_REARME);

        break;

      }

      // Monitoramento da parte traseira.

      if (agora - ultimaLeituraSensor >= INTERVALO_SENSOR_MS) {

        ultimaLeituraSensor = agora;

        float distancia = lerUltrassom();

        // Se detectar um obstaculo proximo, para.

        if (distancia > 0 &&
            distancia < DISTANCIA_SEGURANCA_RETORNO_CM) {

          unsigned long tempoDecorrido =
            agora - tempoInicioRetorno;

          if (tempoDecorrido >= tempoRetornoRestante) {

            tempoRetornoRestante = 0;

          } else {

            tempoRetornoRestante -= tempoDecorrido;

          }

          pararRodas();

          areaLivreCronometrando = false;

          Serial.println("OBSTACULO DETECTADO NO RETORNO!");

          mudarEstado(EST_AGUARDAR_CAMINHO_LIVRE);

        }

      }

      break;

    }


    // ========================================================
    // ESTADO 18 - AGUARDAR VISITANTE SAIR
    // ========================================================

    case EST_REARME: {

      pararRodas();

      olhosAzuis();

      cabeca.write(ANG_CABECA_CENTRO);

      if (agora - ultimaLeituraSensor >= INTERVALO_SENSOR_MS) {

        ultimaLeituraSensor = agora;

        float distancia = lerUltrassom();

        if (distancia > X1 + MARGEM_REARME_CM) {

          if (!areaLivreCronometrando) {

            tempoAreaLivre = agora;

            areaLivreCronometrando = true;

          }

          else if (agora - tempoAreaLivre >= TEMPO_REARME_MS) {

            areaLivreCronometrando = false;

            Serial.println("==============================");

            Serial.println("ECOBOT PRONTO PARA NOVO CICLO!");

            Serial.println("==============================");

            mudarEstado(EST_AGUARDANDO);

          }

        } else {

          areaLivreCronometrando = false;

        }

      }

      break;

    }

  }

}
