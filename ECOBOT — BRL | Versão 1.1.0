#include <Servo.h>

// ============================================================
// ECOBOT - BRL / BLUE SCHOOL
// Versao 2.1 - pausas entre etapas, deslocamento mais lento
// e braco direito espelhado em relacao ao esquerdo.
// ============================================================

// -------------------- 1. PINAGEM -----------------------------
const byte PIN_TRIG = 7;
const byte PIN_ECHO = 8;

const byte PIN_RODA_ESQ = 9;
const byte PIN_RODA_DIR = 10;
const byte PIN_CABECA = 11;
const byte PIN_BRACO_ESQ = 12;
const byte PIN_BRACO_DIR = 13;

const byte PIN_LED_VERMELHO = 2;
const byte PIN_LED_AZUL = 3;
const byte PIN_LED_VERDE = 4;

// -------------------- 2. OBJETOS SERVO ------------------------
Servo rodaEsq;
Servo rodaDir;
Servo cabeca;
Servo bracoEsq;
Servo bracoDir;

// -------------------- 3. PARAMETROS DA APRESENTACAO -----------
// Sensor instalado nas costas e apontado para tras.
const float X1 = 20.0; // ativa a sequencia a 20 cm ou menos

// Cabeca
const int ANGULO_CABECA_FRENTE = 90;
const int ANGULO_CABECA_ESQUERDA = 180;
const int ANGULO_CABECA_DIREITA = 0;

// Bracos: angulo logico do lado esquerdo.
// O lado direito recebe automaticamente (180 - angulo esquerdo).
const int ANGULO_BRACOS_BASE = 170;
const int ANGULO_BRACOS_ESTENDIDO = 130;

// Rodas MG996R 360 graus: comandos mais proximos de 90 = mais lentos.
const int RODA_PARADA = 90;
const int RODA_FRENTE_ESQ = 120;
const int RODA_FRENTE_DIR = 50;
const int RODA_RE_ESQ = 60;
const int RODA_RE_DIR = 132;

// Giro no proprio eixo, em velocidade reduzida.
const int RODA_GIRO_DIREITA_ESQ = 120;
const int RODA_GIRO_DIREITA_DIR = 120;
const int RODA_GIRO_ESQUERDA_ESQ = 60;
const int RODA_GIRO_ESQUERDA_DIR = 60;

// -------------------- 4. TEMPOS DA SEQUENCIA ------------------
const unsigned long TEMPO_OLHADA_LADO_MS = 1700;
const unsigned long TEMPO_PAUSA_FRENTE_MS = 500;

const unsigned long TEMPO_AVANCO_1_MS = 5500;
const unsigned long TEMPO_AVANCO_2_MS = 3500;
const unsigned long TEMPO_GIRO_MS = 3500; // direita e esquerda no retorno

// Pausa aplicada entre cada etapa principal.
// Altere este unico valor para deixar toda a apresentacao
// mais pausada ou mais rapida.
const unsigned long PAUSA_ENTRE_ETAPAS_MS = 500;

// -------------------- 5. SENSOR E REARME -----------------------
const unsigned long INTERVALO_LEITURA_MS = 100;
const byte LEITURAS_PARA_CONFIRMAR = 2;
const float DISTANCIA_REARME = 25.0;
const unsigned long TEMPO_FORA_PARA_REARMAR_MS = 1500;

// -------------------- 6. SUAVIDADE DOS SERVOS -----------------
// Movimento gradual dos servos de posicao (cabeca e bracos).
const byte PASSO_CABECA_GRAUS = 1;
const unsigned long INTERVALO_PASSO_CABECA_MS = 12;
const byte PASSO_BRACO_GRAUS = 1;
const unsigned long INTERVALO_PASSO_BRACO_MS = 20;
const unsigned long ASSENTAMENTO_BRACOS_MS = 250;

const bool DEBUG = true;

// -------------------- 7. ESTADOS ------------------------------
enum EstadoECOBOT {
  AGUARDANDO,
  CENTRALIZANDO_CABECA,
  AVANCO_INICIAL,
  PAUSA_ETAPA,
  ESTENDENDO_BRACOS,
  GIRO_DIREITA,
  SEGUNDO_AVANCO,
  RECOLHENDO_BRACOS,
  RETORNO_SEGUNDO_TRECHO,
  GIRO_ESQUERDA,
  RETORNO_TRECHO_INICIAL,
  FINALIZANDO,
  AGUARDANDO_VISITANTE_SAIR
};

EstadoECOBOT estado = AGUARDANDO;
EstadoECOBOT proximoEstado = AGUARDANDO;
unsigned long inicioEstado = 0;
unsigned long tempoEstado = 0;
bool acaoEstadoIniciada = false;

// -------------------- 8. VARREDURA DA CABECA ------------------
enum FaseVarredura {
  IR_ESQUERDA,
  PAUSAR_ESQUERDA,
  VOLTAR_CENTRO_ESQUERDA,
  PAUSAR_CENTRO_ESQUERDA,
  IR_DIREITA,
  PAUSAR_DIREITA,
  VOLTAR_CENTRO_DIREITA,
  PAUSAR_CENTRO_DIREITA
};

FaseVarredura faseVarredura = IR_ESQUERDA;
unsigned long inicioFaseVarredura = 0;
bool comandoFaseEnviado = false;

// -------------------- 9. CONTROLE GRADUAL DA CABECA ------------
int anguloCabecaAtual = ANGULO_CABECA_FRENTE;
int anguloCabecaAlvo = ANGULO_CABECA_FRENTE;
bool cabecaEmMovimento = false;
unsigned long ultimoPassoCabeca = 0;

void moverCabecaPara(int angulo) {
  anguloCabecaAlvo = constrain(angulo, 0, 180);
  cabecaEmMovimento = (anguloCabecaAtual != anguloCabecaAlvo);
}

void atualizarCabeca() {
  if (!cabecaEmMovimento) return;
  if (millis() - ultimoPassoCabeca < INTERVALO_PASSO_CABECA_MS) return;

  ultimoPassoCabeca = millis();

  if (anguloCabecaAtual < anguloCabecaAlvo) {
    anguloCabecaAtual += PASSO_CABECA_GRAUS;
    if (anguloCabecaAtual > anguloCabecaAlvo) anguloCabecaAtual = anguloCabecaAlvo;
  } else if (anguloCabecaAtual > anguloCabecaAlvo) {
    anguloCabecaAtual -= PASSO_CABECA_GRAUS;
    if (anguloCabecaAtual < anguloCabecaAlvo) anguloCabecaAtual = anguloCabecaAlvo;
  }

  cabeca.write(anguloCabecaAtual);
  cabecaEmMovimento = (anguloCabecaAtual != anguloCabecaAlvo);
}

// -------------------- 10. CONTROLE SINCRONIZADO DOS BRACOS -----
// O angulo informado e a referencia do braco esquerdo.
// O direito e espelhado: 180 - angulo esquerdo.
// Base 170 -> direito 10; estendido 130 -> direito 50.
int anguloBracoEsqAtual = ANGULO_BRACOS_BASE;
int anguloBracoEsqAlvo = ANGULO_BRACOS_BASE;
bool bracosEmMovimento = false;
unsigned long ultimoPassoBracos = 0;
unsigned long fimMovimentoBracos = 0;

int anguloEspelhadoDireito(int anguloEsquerdo) {
  return constrain(180 - anguloEsquerdo, 0, 180);
}

void escreverBracos(int anguloEsquerdo) {
  bracoEsq.write(anguloEsquerdo);
  bracoDir.write(anguloEspelhadoDireito(anguloEsquerdo));
}

void moverBracosPara(int anguloEsquerdo) {
  anguloBracoEsqAlvo = constrain(anguloEsquerdo, 0, 180);
  bracosEmMovimento = (anguloBracoEsqAtual != anguloBracoEsqAlvo);
  if (!bracosEmMovimento) fimMovimentoBracos = millis() + ASSENTAMENTO_BRACOS_MS;
}

void atualizarBracos() {
  if (!bracosEmMovimento) return;
  if (millis() - ultimoPassoBracos < INTERVALO_PASSO_BRACO_MS) return;

  ultimoPassoBracos = millis();

  if (anguloBracoEsqAtual < anguloBracoEsqAlvo) {
    anguloBracoEsqAtual += PASSO_BRACO_GRAUS;
    if (anguloBracoEsqAtual > anguloBracoEsqAlvo) anguloBracoEsqAtual = anguloBracoEsqAlvo;
  } else if (anguloBracoEsqAtual > anguloBracoEsqAlvo) {
    anguloBracoEsqAtual -= PASSO_BRACO_GRAUS;
    if (anguloBracoEsqAtual < anguloBracoEsqAlvo) anguloBracoEsqAtual = anguloBracoEsqAlvo;
  }

  escreverBracos(anguloBracoEsqAtual);

  if (anguloBracoEsqAtual == anguloBracoEsqAlvo) {
    bracosEmMovimento = false;
    fimMovimentoBracos = millis() + ASSENTAMENTO_BRACOS_MS;
  }
}

bool bracosProntos() {
  return !bracosEmMovimento && (long)(millis() - fimMovimentoBracos) >= 0;
}

// -------------------- 11. SENSOR ULTRASSONICO -----------------
float medirDistanciaCM() {
  digitalWrite(PIN_TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(PIN_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(PIN_TRIG, LOW);

  unsigned long duracao = pulseIn(PIN_ECHO, HIGH, 25000UL);
  if (duracao == 0) return -1.0;
  return (duracao * 0.0343) / 2.0;
}

// -------------------- 12. LEDS -------------------------------
void ledAzul() {
  digitalWrite(PIN_LED_AZUL, HIGH);
  digitalWrite(PIN_LED_VERMELHO, LOW);
  digitalWrite(PIN_LED_VERDE, LOW);
}

void ledVermelho() {
  digitalWrite(PIN_LED_AZUL, LOW);
  digitalWrite(PIN_LED_VERMELHO, HIGH);
  digitalWrite(PIN_LED_VERDE, LOW);
}

void ledVerde() {
  digitalWrite(PIN_LED_AZUL, LOW);
  digitalWrite(PIN_LED_VERMELHO, LOW);
  digitalWrite(PIN_LED_VERDE, HIGH);
}

// -------------------- 13. CONTROLE DAS RODAS ------------------
void pararRodas() {
  rodaEsq.write(RODA_PARADA);
  rodaDir.write(RODA_PARADA);
}

void avancarRodas() {
  rodaEsq.write(RODA_FRENTE_ESQ);
  rodaDir.write(RODA_FRENTE_DIR);
}

void recuarRodas() {
  rodaEsq.write(RODA_RE_ESQ);
  rodaDir.write(RODA_RE_DIR);
}

void girarRodasDireita() {
  rodaEsq.write(RODA_GIRO_DIREITA_ESQ);
  rodaDir.write(RODA_GIRO_DIREITA_DIR);
}

void girarRodasEsquerda() {
  rodaEsq.write(RODA_GIRO_ESQUERDA_ESQ);
  rodaDir.write(RODA_GIRO_ESQUERDA_DIR);
}

// -------------------- 14. ESTADOS E PAUSAS --------------------
void mudarEstado(EstadoECOBOT novoEstado) {
  estado = novoEstado;
  inicioEstado = millis();
  acaoEstadoIniciada = false;

  if (DEBUG) {
    Serial.print("Estado: ");
    Serial.println((int)estado);
  }
}

void iniciarPausa(EstadoECOBOT proximo) {
  pararRodas();
  proximoEstado = proximo;
  mudarEstado(PAUSA_ETAPA);
}

void reiniciarVarredura() {
  faseVarredura = IR_ESQUERDA;
  comandoFaseEnviado = false;
  inicioFaseVarredura = millis();
}

// Varredura continua: esquerda -> frente -> direita -> frente.
void atualizarVarreduraCabeca() {
  switch (faseVarredura) {
    case IR_ESQUERDA:
      if (!comandoFaseEnviado) {
        moverCabecaPara(ANGULO_CABECA_ESQUERDA);
        comandoFaseEnviado = true;
      }
      if (!cabecaEmMovimento) {
        inicioFaseVarredura = millis();
        faseVarredura = PAUSAR_ESQUERDA;
      }
      break;

    case PAUSAR_ESQUERDA:
      if (millis() - inicioFaseVarredura >= TEMPO_OLHADA_LADO_MS) {
        comandoFaseEnviado = false;
        faseVarredura = VOLTAR_CENTRO_ESQUERDA;
      }
      break;

    case VOLTAR_CENTRO_ESQUERDA:
      if (!comandoFaseEnviado) {
        moverCabecaPara(ANGULO_CABECA_FRENTE);
        comandoFaseEnviado = true;
      }
      if (!cabecaEmMovimento) {
        inicioFaseVarredura = millis();
        faseVarredura = PAUSAR_CENTRO_ESQUERDA;
      }
      break;

    case PAUSAR_CENTRO_ESQUERDA:
      if (millis() - inicioFaseVarredura >= TEMPO_PAUSA_FRENTE_MS) {
        comandoFaseEnviado = false;
        faseVarredura = IR_DIREITA;
      }
      break;

    case IR_DIREITA:
      if (!comandoFaseEnviado) {
        moverCabecaPara(ANGULO_CABECA_DIREITA);
        comandoFaseEnviado = true;
      }
      if (!cabecaEmMovimento) {
        inicioFaseVarredura = millis();
        faseVarredura = PAUSAR_DIREITA;
      }
      break;

    case PAUSAR_DIREITA:
      if (millis() - inicioFaseVarredura >= TEMPO_OLHADA_LADO_MS) {
        comandoFaseEnviado = false;
        faseVarredura = VOLTAR_CENTRO_DIREITA;
      }
      break;

    case VOLTAR_CENTRO_DIREITA:
      if (!comandoFaseEnviado) {
        moverCabecaPara(ANGULO_CABECA_FRENTE);
        comandoFaseEnviado = true;
      }
      if (!cabecaEmMovimento) {
        inicioFaseVarredura = millis();
        faseVarredura = PAUSAR_CENTRO_DIREITA;
      }
      break;

    case PAUSAR_CENTRO_DIREITA:
      if (millis() - inicioFaseVarredura >= TEMPO_PAUSA_FRENTE_MS) {
        comandoFaseEnviado = false;
        faseVarredura = IR_ESQUERDA;
      }
      break;
  }
}

// -------------------- 15. SETUP -------------------------------
void setup() {
  if (DEBUG) Serial.begin(9600);

  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
  pinMode(PIN_LED_VERMELHO, OUTPUT);
  pinMode(PIN_LED_AZUL, OUTPUT);
  pinMode(PIN_LED_VERDE, OUTPUT);

  rodaEsq.attach(PIN_RODA_ESQ);
  rodaDir.attach(PIN_RODA_DIR);
  cabeca.attach(PIN_CABECA);
  bracoEsq.attach(PIN_BRACO_ESQ);
  bracoDir.attach(PIN_BRACO_DIR);

  pararRodas();

  anguloCabecaAtual = ANGULO_CABECA_FRENTE;
  anguloCabecaAlvo = ANGULO_CABECA_FRENTE;
  cabeca.write(ANGULO_CABECA_FRENTE);

  anguloBracoEsqAtual = ANGULO_BRACOS_BASE;
  anguloBracoEsqAlvo = ANGULO_BRACOS_BASE;
  escreverBracos(ANGULO_BRACOS_BASE);
  fimMovimentoBracos = millis() + ASSENTAMENTO_BRACOS_MS;

  ledAzul();
  reiniciarVarredura();

  if (DEBUG) {
    Serial.println("ECOBOT iniciado - BRL");
    Serial.println("Aguardando aproximacao a 20 cm ou menos.");
  }
}

// -------------------- 16. LOOP PRINCIPAL ----------------------
void loop() {
  atualizarCabeca();
  atualizarBracos();

  unsigned long agora = millis();

  switch (estado) {

    // AGUARDANDO: o sensor e lido durante a varredura da cabeca.
    case AGUARDANDO: {
      pararRodas();
      ledAzul();
      atualizarVarreduraCabeca();

      static unsigned long ultimaLeitura = 0;
      static byte confirmacoes = 0;

      if (agora - ultimaLeitura >= INTERVALO_LEITURA_MS) {
        ultimaLeitura = agora;
        float distancia = medirDistanciaCM();

        if (distancia > 0 && distancia <= X1) confirmacoes++;
        else confirmacoes = 0;

        if (DEBUG && distancia > 0) {
          Serial.print("Distancia: ");
          Serial.print(distancia);
          Serial.println(" cm");
        }

        if (confirmacoes >= LEITURAS_PARA_CONFIRMAR) {
          confirmacoes = 0;
          pararRodas();
          moverCabecaPara(ANGULO_CABECA_FRENTE);
          ledVermelho();
          if (DEBUG) Serial.println("Aproximacao detectada!");
          mudarEstado(CENTRALIZANDO_CABECA);
        }
      }
      break;
    }

    // Centraliza a cabeca antes de iniciar a sequencia.
    case CENTRALIZANDO_CABECA:
      pararRodas();
      if (!cabecaEmMovimento) iniciarPausa(AVANCO_INICIAL);
      break;

    // Pausa geral entre etapas.
    case PAUSA_ETAPA:
      pararRodas();
      if (agora - inicioEstado >= PAUSA_ENTRE_ETAPAS_MS) {
        mudarEstado(proximoEstado);
      }
      break;

    // Primeiro avanço: 4 segundos, em velocidade reduzida.
    case AVANCO_INICIAL:
      if (!acaoEstadoIniciada) {
        avancarRodas();
        tempoEstado = agora;
        acaoEstadoIniciada = true;
      }
      if (agora - tempoEstado >= TEMPO_AVANCO_1_MS) {
        pararRodas();
        iniciarPausa(ESTENDENDO_BRACOS);
      }
      break;

    // Estende os bracos: esquerdo 130; direito espelhado 50.
    case ESTENDENDO_BRACOS:
      pararRodas();
      if (!acaoEstadoIniciada) {
        moverBracosPara(ANGULO_BRACOS_ESTENDIDO);
        acaoEstadoIniciada = true;
      }
      if (bracosProntos()) iniciarPausa(GIRO_DIREITA);
      break;

    // Giro para a direita durante 500 ms.
    case GIRO_DIREITA:
      if (!acaoEstadoIniciada) {
        girarRodasDireita();
        tempoEstado = agora;
        acaoEstadoIniciada = true;
      }
      if (agora - tempoEstado >= TEMPO_GIRO_MS) {
        pararRodas();
        iniciarPausa(SEGUNDO_AVANCO);
      }
      break;

    // Segundo avanço: 2,5 segundos.
    case SEGUNDO_AVANCO:
      if (!acaoEstadoIniciada) {
        avancarRodas();
        tempoEstado = agora;
        acaoEstadoIniciada = true;
      }
      if (agora - tempoEstado >= TEMPO_AVANCO_2_MS) {
        pararRodas();
        iniciarPausa(RECOLHENDO_BRACOS);
      }
      break;

    // Retorna os bracos para base: esquerdo 170; direito espelhado 10.
    case RECOLHENDO_BRACOS:
      pararRodas();
      if (!acaoEstadoIniciada) {
        moverBracosPara(ANGULO_BRACOS_BASE);
        acaoEstadoIniciada = true;
      }
      if (bracosProntos()) iniciarPausa(RETORNO_SEGUNDO_TRECHO);
      break;

    // Retorno do segundo trecho: re por 2,5 segundos.
    case RETORNO_SEGUNDO_TRECHO:
      if (!acaoEstadoIniciada) {
        recuarRodas();
        tempoEstado = agora;
        acaoEstadoIniciada = true;
      }
      if (agora - tempoEstado >= TEMPO_AVANCO_2_MS) {
        pararRodas();
        iniciarPausa(GIRO_ESQUERDA);
      }
      break;

    // Desfaz o giro para a esquerda durante os mesmos 500 ms.
    case GIRO_ESQUERDA:
      if (!acaoEstadoIniciada) {
        girarRodasEsquerda();
        tempoEstado = agora;
        acaoEstadoIniciada = true;
      }
      if (agora - tempoEstado >= TEMPO_GIRO_MS) {
        pararRodas();
        iniciarPausa(RETORNO_TRECHO_INICIAL);
      }
      break;

    // Retorno do primeiro trecho: re por 4 segundos.
    case RETORNO_TRECHO_INICIAL:
      if (!acaoEstadoIniciada) {
        recuarRodas();
        tempoEstado = agora;
        acaoEstadoIniciada = true;
      }
      if (agora - tempoEstado >= TEMPO_AVANCO_1_MS) {
        pararRodas();
        moverCabecaPara(ANGULO_CABECA_FRENTE);
        iniciarPausa(FINALIZANDO);
      }
      break;

    // Finaliza e espera os servos chegarem a posicao inicial.
    case FINALIZANDO:
      pararRodas();
      if (!cabecaEmMovimento && bracosProntos()) {
        ledVerde();
        if (DEBUG) Serial.println("Sequencia concluida. Aguardando area livre.");
        mudarEstado(AGUARDANDO_VISITANTE_SAIR);
      }
      break;

    // Rearma somente depois que o visitante se afastar.
    case AGUARDANDO_VISITANTE_SAIR: {
      pararRodas();
      ledVerde();

      static unsigned long ultimaLeituraRearme = 0;
      static unsigned long inicioAreaLivre = 0;
      static bool contandoAreaLivre = false;

      if (agora - ultimaLeituraRearme >= INTERVALO_LEITURA_MS) {
        ultimaLeituraRearme = agora;
        float distancia = medirDistanciaCM();
        bool areaLivre = (distancia < 0 || distancia > DISTANCIA_REARME);

        if (areaLivre) {
          if (!contandoAreaLivre) {
            inicioAreaLivre = agora;
            contandoAreaLivre = true;
          } else if (agora - inicioAreaLivre >= TEMPO_FORA_PARA_REARMAR_MS) {
            contandoAreaLivre = false;
            moverCabecaPara(ANGULO_CABECA_FRENTE);
            ledAzul();
            reiniciarVarredura();
            if (DEBUG) Serial.println("Area livre. Novo ciclo liberado.");
            mudarEstado(AGUARDANDO);
          }
        } else {
          contandoAreaLivre = false;
        }
      }
      break;
    }
  }
}
